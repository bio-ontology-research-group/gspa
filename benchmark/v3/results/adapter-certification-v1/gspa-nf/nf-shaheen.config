// Shaheen III (project k10018) profile for gspa-nf: Slurm executor, Singularity images pulled by the
// head process on the login node into /scratch, excluded nodes nid00022,nid00497,nid01033, databases
// on /project. Used by benchmark/v3/shaheen/nf-shaheen-run.sh for the row-3 container certification.
process {
    executor = 'slurm'
    queue = 'workq'
    clusterOptions = '--account=k10018 --exclude=nid00022,nid00497,nid01033'
    cpus = 8
    memory = '32 GB'
    time = '2h'
    errorStrategy = 'terminate'
    withName: 'PYRODIGAL'      { cpus = 4;  memory = '8 GB';  time = '30m' }
    withName: 'DIAMOND_BLASTP' { cpus = 16; memory = '32 GB'; time = '1h' }
    withName: 'HMMSEARCH'      { cpus = 32; memory = '64 GB'; time = '3h' }
    withName: 'BARRNAP'        { cpus = 4;  memory = '8 GB';  time = '30m' }
    withName: 'MINCED'         { cpus = 2;  memory = '4 GB';  time = '30m' }
    withName: 'MERGE_ANNOTATIONS' { cpus = 2; memory = '4 GB'; time = '30m' }
}
singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/scratch/hohndor/gspa-cert/nf-cache'
}
docker.enabled = false
// Nextflow refuses to overwrite an existing trace/report (the 03:29 run on 2026-11-02 left the
// previous attempt's trace in place); the trace carries the container of every task.
trace {
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,memory,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar'
}
report { overwrite = true }
executor {
    queueSize = 8
    submitRateLimit = '5/1sec'
}
workDir = '/scratch/hohndor/gspa-cert/nf-work'
