/*
 * GSPA - Genome-Scale Protein Annotation Pipeline
 * Nextflow configuration
 */

params {
    // Input
    input       = null          // FASTA file or samplesheet CSV
    kingdom     = 'bacteria'    // bacteria, archaea, eukaryote, virus, auto
    mag         = false

    // Databases (required for core annotation)
    diamond_db  = null          // DIAMOND database (.dmnd)
    pfam_db     = null          // Pfam-A.hmm (hmmpress'd)

    // Databases (optional)
    interproscan_dir = null     // InterProScan installation directory (contains interproscan.sh + data/)
    foldseek_db  = null         // FoldSeek structure database
    prostt5_model = null        // ProstT5 model for sequence-to-structure search
    mmseqs2_db   = null         // MMseqs2 database
    eggnog_db    = null         // eggNOG-mapper data directory
    amrfinder_db = null         // AMRFinderPlus database
    antismash_db = null         // antiSMASH database directory
    dbcan_db     = null         // dbCAN database directory
    gtdbtk_db    = null         // GTDB-Tk reference data (set GTDBTK_DATA_PATH)
    checkm2_db   = null         // CheckM2 DIAMOND database (.dmnd)

    // Quality assessment
    go_owl      = null          // GO OWL file for quality metrics
    go_obo      = null          // go.obo for EVAL_PGAP aspect lookup

    // Neural function predictors
    esm2_dgp_ckpt        = null  // ESM2-DeepGOPlus head .pt
    esm2_dgp_terms       = null  // GO term vocabulary (one per line)
    esm2_dgp_model       = 'esm2_t33_650M_UR50D'
    esm2_dgp_batch_size  = 16
    esm2_centroid_db     = null  // NPZ centroid DB
    esm2_centroid_model  = 'esm2_t12_35M_UR50D'
    esm2_centroid_top_k  = 5
    esm2_centroid_batch_size = 32
    clean_model_dir      = null  // CLEAN repo dir with weights
    clean_batch_size     = 16
    proteinfer_model_dir = null  // ProteInfer SavedModel directory
    proteinfer_batch_size = 16
    neural_min_score     = 0.1   // shared sidecar emit threshold

    // Ensemble fusion (per-protein)
    ensemble_mode        = 'mean'   // max | mean | rank
    ensemble_min_score   = 0.0

    // Genomic-region ensemble (geNomad / CheckV / PhiSpy / VirSorter2 / VIBRANT)
    genomic_ensemble_mode        = 'max'   // max | mean | wcov
    genomic_ensemble_min_overlap = 0.5     // reciprocal overlap threshold
    genomic_ensemble_min_score   = 0.0
    run_ensemble_genomic         = false

    // Eval (opt-in)
    truth_dir            = null   // dir with <sample_id>_truth.tsv files
    eval_truth_name      = 'truth'
    eval_n_bootstrap     = 0      // 0 = point estimate, no CI

    // Multi-format report (HTML + RDF/Turtle + JSON-LD)
    report_min_score     = 0.0    // drop low-score rows from report

    // ----- Region predictors (FOSS) -----
    metapredict_min_score      = 0.5
    metapredict_min_region_len = 10
    deepsig_min_score          = 0.5
    deepsig_kingdom            = 'gramn'   // gramp | gramn | euk
    tmbed_min_score            = 0.5
    tmbed_prott5_dir           = null      // path to ProtT5 weights (~5 GB)
    tppred3_min_score          = 0.5
    tppred3_kingdom            = 'nonplant' // plant | nonplant

    // ----- Term-extras (FOSS, auto-join ensemble) -----
    psortb_min_score           = 0.7
    psortb_gram                = 'negative' // positive | negative | archaea
    deepfri_model_dir          = null
    deepfri_min_score          = 0.5
    deepec_model_dir           = null       // ⚠ AGPL-3.0; service deployments must publish source
    deepec_min_score           = 0.5
    deeparg_model_dir          = null
    deeparg_min_score          = 0.5
    deeparg_type               = 'prot'

    // ----- Site predictors (FOSS) -----
    musitedeep_model_dir       = null
    musitedeep_residue_types   = 'Phosphoserine_Phosphothreonine'
    musitedeep_min_score       = 0.5
    scannet_model_dir          = null
    scannet_min_score          = 0.5

    // ----- Optional structure provisioning -----
    structures_from            = 'none'     // none | esmfold | afdb

    // ----- v1.3 phage / prophage track (FOSS) -----
    genomad_db                 = null       // path to geNomad model DB
    genomad_min_score          = 0.7
    checkv_db                  = null       // path to CheckV DB
    checkv_min_score           = 0.5
    phispy_input               = null       // optional GenBank file for PhiSpy
    phispy_min_score           = 0.5

    // ----- v1.4 viral expansion (FOSS) -----
    virsorter2_db              = null       // ~11 GB VS2 database
    virsorter2_min_score       = 0.5
    vibrant_db                 = null       // VIBRANT HMM databases dir
    vibrant_min_score          = 0.5

    // Optional licensed tools
    signalp_path = null         // Path to SignalP v6 executable (requires license)

    // Output
    outdir      = 'results'

    // Tool toggles (auto-enabled when database is provided)
    run_diamond      = true
    run_hmmer        = true
    run_barrnap      = true
    run_minced       = true
    run_interproscan = false    // Set true + provide interproscan_dir
    run_foldseek     = false    // Set true + provide foldseek_db or prostt5_model
    run_mmseqs2      = false    // Alternative to DIAMOND
    run_eggnog       = false    // Set true + provide eggnog_db
    run_amrfinder    = false    // Set true + provide amrfinder_db
    run_antismash    = false    // Set true + provide antismash_db
    run_dbcan        = false    // Set true + provide dbcan_db
    run_gtdbtk       = false    // Set true + provide gtdbtk_db (MAGs)
    run_checkm2      = false    // Set true + provide checkm2_db (MAGs)
    run_signalp      = false    // Set true + provide signalp_path (licensed)

    // Neural predictor toggles (require corresponding databases)
    run_esm2_deepgoplus = false
    run_esm2_centroid   = false
    run_clean           = false
    run_proteinfer      = false
    run_ensemble        = false
    run_eval            = false
    run_report          = false   // emit HTML + Turtle + JSON-LD per sample

    // FOSS region / term-extras / site predictor toggles
    run_metapredict     = false
    run_deepsig         = false
    run_tmbed           = false
    run_tppred3         = false
    run_psortb          = false
    run_deepfri         = false
    run_deepec          = false  // AGPL-3.0; OK for local + cluster
    run_deeparg         = false
    run_musitedeep      = false
    run_scannet         = false  // requires structures_from != none

    // v1.3 viral / prophage predictors
    run_genomad                = false
    run_checkv                 = false
    run_phispy                 = false  // requires GenBank input
    run_flatten_prophage_cds   = false  // fan out genomic regions to per-CDS

    // v1.4 viral expansion
    run_virsorter2             = false  // GPL-2; FOSS biocontainer
    run_vibrant                = false  // GPL-3; FOSS biocontainer

    // Resources
    max_cpus    = Runtime.runtime.availableProcessors()
    max_memory  = '32.GB'
    max_time    = '24.h'
}

// Container definitions — one per tool
process {
    withName: 'PYRODIGAL'       { container = 'quay.io/biocontainers/pyrodigal:3.7.1--py312h247cb63_1' }
    withName: 'DIAMOND_BLASTP'  { container = 'quay.io/biocontainers/diamond:2.1.9--h43eeafb_0' }
    withName: 'HMMSEARCH'       { container = 'quay.io/biocontainers/hmmer:3.4--hb6cb901_4' }
    withName: 'BARRNAP'         { container = 'quay.io/biocontainers/barrnap:0.8--0' }
    withName: 'MINCED'          { container = 'quay.io/biocontainers/minced:0.3.0--0' }
    withName: 'AMRFINDER'       { container = 'quay.io/biocontainers/ncbi-amrfinderplus:4.2.7--hf69ffd2_0' }
    withName: 'FOLDSEEK'        { container = 'quay.io/biocontainers/foldseek:10.941cd33--h5021889_1' }
    withName: 'MMSEQS2_SEARCH'  { container = 'quay.io/biocontainers/mmseqs2:17.b804f--hd6d6fdc_1' }
    withName: 'EGGNOG_MAPPER'   { container = 'quay.io/biocontainers/eggnog-mapper:2.1.13--pyhdfd78af_2' }
    withName: 'ANTISMASH'       { container = 'quay.io/biocontainers/antismash-lite:8.0.1--pyhdfd78af_0' }
    withName: 'DBCAN'           { container = 'quay.io/biocontainers/dbcan:5.2.8--pyhdfd78af_0' }
    withName: 'CHECKM2'         { container = 'quay.io/biocontainers/checkm2:1.1.0--pyh7e72e81_1' }
    withName: 'GTDBTK'          { container = 'quay.io/biocontainers/gtdbtk:2.6.1--pyh1f0d9b5_2' }
    withName: 'MERGE_ANNOTATIONS|GSPA_REPORT' { container = 'python:3.12-slim' }

    // Neural predictors — published on Docker Hub at docker.io/leechuck/.
    // See gspa-nf/docker/README.md for build/push instructions.
    withName: 'ESM2_DEEPGOPLUS|ESM2_CENTROID|CLEAN' { container = 'leechuck/gspa-esm2-stack:0.1' }
    withName: 'PROTEINFER'                          { container = 'leechuck/gspa-proteinfer-stack:0.1' }
    withName: 'ENSEMBLE_PREDS|EVAL_PGAP|MAKE_REPORT' { container = 'leechuck/gspa-eval-stack:0.1' }

    // FOSS additions (all OSI-licensed)
    withName: 'METAPREDICT|DEEPSIG|TMBED|TPPRED3'    { container = 'leechuck/gspa-region-stack:0.1' }
    withName: 'DEEPFRI|DEEPEC|DEEPARG|MUSITEDEEP'    { container = 'leechuck/gspa-tf-stack:0.1' }
    withName: 'SCANNET|STRUCTURE_PROVIDER'           { container = 'leechuck/gspa-struct-stack:0.1' }
    withName: 'PSORTB'                               { container = 'brinkmanlab/psortb_commandline:1.0.4' }

    // v1.3 viral / prophage predictors — upstream biocontainers
    withName: 'GENOMAD' { container = 'quay.io/biocontainers/genomad:1.7.4--pyhdfd78af_0' }
    withName: 'CHECKV'  { container = 'quay.io/biocontainers/checkv:1.0.3--pyhdfd78af_0' }
    withName: 'PHISPY'  { container = 'quay.io/biocontainers/phispy:4.2.21--py310h590eda1_2' }
    withName: 'FLATTEN_PROPHAGE_CDS' { container = 'python:3.12-slim' }

    // v1.4 viral expansion — upstream biocontainers
    withName: 'VIRSORTER2' { container = 'quay.io/biocontainers/virsorter:2.2.4--pyhdfd78af1_2' }
    withName: 'VIBRANT'    { container = 'quay.io/biocontainers/vibrant:1.2.1--hdfd78af_2' }
}

profiles {
    standard {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    local {
        process.container = null
        docker.enabled = false
    }
    test {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        params.input = "${projectDir}/../test-data/genomes/m_genitalium.fna"
        params.diamond_db = "${projectDir}/../test-data/databases/uniprot_sprot.dmnd"
        params.pfam_db = "${projectDir}/../test-data/databases/Pfam-A.hmm"
        params.outdir = "${projectDir}/../test-data/nf-output"
        params.kingdom = 'bacteria'
    }
    // GPU runtime — toggleable on top of docker / singularity.
    // Use as: -profile docker,gpu  (or: singularity,gpu)
    gpu {
        process {
            withName: 'ESM2_DEEPGOPLUS|ESM2_CENTROID|CLEAN|PROTEINFER' {
                if (workflow.containerEngine == 'singularity') {
                    containerOptions = '--nv'
                } else {
                    containerOptions = '--gpus all'
                }
            }
        }
    }
    // CPU-only smoke test for ProteInfer + ensemble + eval. No GPU, no DIAMOND,
    // no Pfam — just neural plumbing on a tiny genome.
    smoke_proteinfer {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        params.input = "${projectDir}/test/smoke_neural.csv"
        params.outdir = "${projectDir}/test/nf-output"
        params.run_diamond  = false
        params.run_hmmer    = false
        params.run_barrnap  = false
        params.run_minced   = false
        params.run_proteinfer = true
        params.run_ensemble = true
        params.run_eval     = true
        params.run_report   = true
        params.truth_dir    = "${projectDir}/test/truth"
        params.proteinfer_model_dir = System.getenv('GSPA_DB') ? "${System.getenv('GSPA_DB')}/proteinfer/v1.0/model" : null
    }
}
