// SLURM + Singularity config for unimatrix01 — overlay on top of nextflow.config

process {
    executor = 'slurm'
    queue = 'debug'
    // /data (GlusterFS) is mounted on all worker nodes and Singularity
    // is available everywhere, but node007 is currently stuck in
    // COMPLETING state (slurmd epilog issue) so exclude it.
    clusterOptions = '--exclude=node007'
    cpus = 4
    memory = '8 GB'
    time = '2h'

    // GlusterFS occasionally surfaces stale cache file data on workers
    // so that singularity reports "image format not recognized". Retry
    // transparently; the scheduler usually lands on a different node on
    // retry and the re-read succeeds.
    errorStrategy = { task.exitStatus in 1..255 ? 'retry' : 'terminate' }
    maxRetries = 2

    withName: 'PYRODIGAL'      { cpus = 2;  memory = '2 GB';  time = '15m' }
    withName: 'DIAMOND_BLASTP' { cpus = 8;  memory = '8 GB';  time = '30m' }
    withName: 'HMMSEARCH'      { cpus = 8;  memory = '12 GB'; time = '1h' }
    withName: 'INTERPROSCAN'   { cpus = 8;  memory = '12 GB'; time = '4h' }
    withName: 'BARRNAP'        { cpus = 2;  memory = '2 GB';  time = '15m' }
    withName: 'MINCED'         { cpus = 1;  memory = '2 GB';  time = '15m' }
    withName: 'MERGE_ANNOTATIONS' {
        cpus = 2
        memory = '2 GB'
        time = '15m'
        // Full python image (has procps/ps for Nextflow task-metric
        // collection; python:3.12-slim does not).
        container = 'docker://python:3.12'
    }
}

singularity {
    enabled = true
    autoMounts = true
    // Cache on GlusterFS (shared, but has consistency issues across nodes).
    // The beforeScript copies each image to node-local /tmp before use,
    // working around Gluster read-staleness.
    cacheDir = '/data/hohndor/gspa/nf-test/singularity_cache'
}

// Pre-warm the FUSE cache with a full read of every cached image before
// the task's singularity invocation runs. This forces GlusterFS to fetch
// fresh bytes from the authoritative brick on each node, working around
// stale-cache issues where a worker occasionally sees a truncated/corrupt
// version of a file that is intact on the login node.
process.beforeScript = '''
for img in /data/hohndor/gspa/nf-test/singularity_cache/*.img; do
    cat "$img" > /dev/null 2>&1 || true
done
'''

// Disable Docker (the default 'standard' profile sets it on)
docker.enabled = false

executor {
    queueSize = 8
    submitRateLimit = '5/1sec'
}
