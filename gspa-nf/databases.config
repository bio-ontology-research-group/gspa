/*
 * GSPA Database Configuration
 *
 * This file tells the pipeline where to find tool databases.
 * Copy this template and edit paths for your system.
 *
 * Usage:
 *   nextflow run gspa-nf/main.nf -c databases.config --input genome.fna -profile docker
 */

params {
    // ----- Required databases -----

    // DIAMOND database (Swiss-Prot or UniRef90)
    // Build with: diamond makedb --in uniprot_sprot.fasta --db uniprot_sprot
    diamond_db  = null   // e.g., '/path/to/uniprot_sprot.dmnd'

    // Pfam-A HMM database (must be hmmpress'd)
    // Download: wget https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz
    // Prepare:  gunzip Pfam-A.hmm.gz && hmmpress Pfam-A.hmm
    pfam_db     = null   // e.g., '/path/to/Pfam-A.hmm'

    // ----- Optional databases -----

    // FoldSeek structure database (AlphaFold/Swiss-Prot or AlphaFold/UniProt50)
    // Download: foldseek databases Alphafold/Swiss-Prot /path/to/afdb_sprot /tmp
    // ProstT5 model for sequence-based structural search (no pre-computed structures needed)
    // Download: foldseek databases ProstT5 /path/to/prostt5 /tmp
    foldseek_db = null   // e.g., '/path/to/afdb_sprot'
    prostt5_model = null // e.g., '/path/to/prostt5'

    // MMseqs2 database (alternative to DIAMOND)
    // Build with: mmseqs createdb uniprot_sprot.fasta mmseqs2_sprot
    mmseqs2_db  = null   // e.g., '/path/to/mmseqs2_sprot'

    // eggNOG-mapper database
    // Download from: http://eggnog5.embl.de/#/app/downloads
    //   wget http://eggnog5.embl.de/download/emapperdb-5.0.2/eggnog.db.gz
    //   wget http://eggnog5.embl.de/download/emapperdb-5.0.2/eggnog_proteins.dmnd.gz
    //   wget http://eggnog5.embl.de/download/emapperdb-5.0.2/eggnog.taxa.tar.gz
    //   gunzip eggnog.db.gz eggnog_proteins.dmnd.gz && tar xzf eggnog.taxa.tar.gz
    eggnog_db   = null   // e.g., '/path/to/eggnog_data/'

    // AMRFinderPlus database
    // Download: amrfinder_update -d /path/to/amrfinder_db
    amrfinder_db = null  // e.g., '/path/to/amrfinder_db/latest'

    // antiSMASH database
    // Download: download-antismash-databases --database-dir /path/to/antismash_db
    antismash_db = null  // e.g., '/path/to/antismash_db'

    // dbCAN database (CAZymes)
    // Download: run_dbcan database --db_dir /path/to/dbcan_db --no-cgc --aws_s3
    dbcan_db    = null   // e.g., '/path/to/dbcan_db'

    // GTDB-Tk reference database (~85GB extracted)
    // Download: wget https://data.gtdb.ecogenomic.org/releases/release220/220.0/auxillary_files/gtdbtk_package/full_package/gtdbtk_r220_data.tar.gz
    // Extract:  tar xzf gtdbtk_r220_data.tar.gz
    gtdbtk_db   = null   // e.g., '/path/to/release220'

    // CheckM2 database
    // Download: checkm2 database --download --path /path/to/checkm2_db
    // Or: wget https://zenodo.org/records/14897628/files/checkm2_database.tar.gz
    checkm2_db  = null   // e.g., '/path/to/CheckM2_database/uniref100.KO.1.dmnd'

    // GO OWL file (for quality assessment)
    // Download: wget http://purl.obolibrary.org/obo/go.owl
    go_owl      = null   // e.g., '/path/to/go.owl'

    // ----- Neural function predictors -----
    //
    // The canonical source for these artefacts is the database manifest at
    //   gspa-nf/database_manifest.tsv
    // Fetch with:
    //   bash gspa-nf/fetch_databases.sh --predictor proteinfer --predictor truth \
    //                                   --dest ~/gspa-db
    // The script prints the export lines for this section.
    //
    // ESM2-DeepGOPlus (frozen ESM2-t33 + FC head over ~5,707 GO terms; GPU recommended)
    esm2_dgp_ckpt        = null  // e.g. '/path/to/esm2_dgp/v1.0/head.pt'
    esm2_dgp_terms       = null  // e.g. '/path/to/esm2_dgp/v1.0/terms.txt'

    // ESM2-centroid (NPZ centroid DB; CPU-OK)
    esm2_centroid_db     = null  // e.g. '/path/to/esm2_centroid/v1.0/db.npz'

    // CLEAN — ESM2 + contrastive head for EC (GPU recommended)
    clean_model_dir      = null  // e.g. '/path/to/clean/v1.0/CLEAN'

    // ProteInfer — TF SavedModel (CPU-OK)
    proteinfer_model_dir = null  // e.g. '/path/to/proteinfer/v1.0/model'

    // Eval (opt-in)
    truth_dir            = null  // dir with <sample_id>_truth.tsv files
    go_obo               = null  // e.g. '/path/to/go/2026.04/go.obo'

    // ----- Proprietary tools (optional, requires license) -----

    // SignalP v6 (requires academic license from DTU Health Tech)
    // Set to the path of your signalp installation
    signalp_path = null  // e.g., '/path/to/signalp-6.0/bin/signalp'
}
