work/
nextflow

# Large test data (held out of version control)
test-data/

# Reference paper directory is tracked in its own upstream git repo.
resources/genome-scale-function/

# Python bytecode
__pycache__/
*.pyc

# Claude Code state
.claude/

# Neural sidecar weights (orix-resident, never committed)
benchmark/neural/glm_weights
benchmark/neural/glm_weights/
benchmark/neural/esm2_weights
benchmark/neural/esm2_weights/

# Generated tutorial artifacts. The HTML viewer for a tutorial is built
# from the tutorial scripts + cluster outputs and embeds the FASTA + all
# annotations (10s of MB); reproduce it with `gspa visualize` instead of
# committing the binary blob.
tutorials/*/visualization/*.html
tutorials/*/*_browser.html
tutorials/*/visualization/data/

# Syncthing & temporary release staging
.stfolder/
dist/

# Downloaded open-access reference PDFs (keep markdown reviews & .bib tracked)
literature/pdfs/

# Large CAFA6 scratch data
benchmark/neural/cafa6_recon/pdbs_cleanA/
benchmark/neural/cafa6_recon/deepfri_struct_out/
benchmark/neural/cafa6_recon/*.faa
benchmark/neural/cafa6_recon/*.sh

# LaTeX build intermediates (keep main.tex, references.bib, main.pdf, figures/)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.lof
paper/*.lot
paper/*.toc

# Root shadow jar and large raw pickle/RDS caches (preserved on disk; compact .pkl.gz, JSONs, and TSVs are tracked)
gspa-unified.jar
benchmark/manifests/reference_data/ibex_extracted/*.pkl
benchmark/manifests/reference_data/ibex_extracted/gapseq_eval/
benchmark/manifests/reference_data/meteor_v7_run/
benchmark/manifests/reference_data/paperA_2026/
benchmark/manifests/reference_data/psb_revision/

