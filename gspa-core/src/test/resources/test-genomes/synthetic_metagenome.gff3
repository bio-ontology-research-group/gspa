##gff-version 3
# Synthetic metagenome: 3 bins simulating MAGs
# bin1: Bacterium (3 proteins, complete)
# bin2: Bacterium (2 proteins, missing one contig = incomplete MAG)
# bin3: Archaeon (2 proteins, one contaminating bacterial contig)
##sequence-region bin1_contig1 1 300
##sequence-region bin1_contig2 1 200
##sequence-region bin2_contig1 1 300
##sequence-region bin3_contig1 1 200
##sequence-region bin3_contig2_contam 1 150
bin1_contig1	prodigal	CDS	1	150	.	+	0	ID=bin1_p001;Name=dnaA;product=Chromosomal replication initiator;locus_tag=B1_0001
bin1_contig1	prodigal	CDS	155	300	.	+	0	ID=bin1_p002;Name=gyrA;product=DNA gyrase subunit A;locus_tag=B1_0002
bin1_contig2	prodigal	CDS	1	200	.	+	0	ID=bin1_p003;Name=rpoB;product=RNA polymerase subunit beta;locus_tag=B1_0003
bin2_contig1	prodigal	CDS	1	150	.	+	0	ID=bin2_p001;Name=ftsZ;product=Cell division protein FtsZ;locus_tag=B2_0001
bin2_contig1	prodigal	CDS	155	300	.	+	0	ID=bin2_p002;Name=murA;product=UDP-N-acetylglucosamine 1-carboxyvinyltransferase;locus_tag=B2_0002
bin3_contig1	prodigal	CDS	1	200	.	+	0	ID=bin3_p001;Name=mcrA;product=Methyl-coenzyme M reductase subunit alpha;locus_tag=A1_0001
bin3_contig2_contam	prodigal	CDS	1	150	.	+	0	ID=bin3_p002;Name=bla;product=Beta-lactamase;locus_tag=A1_0002
